# 视频下载工具箱 - 运行时产物（不入库）
runtime/
downloads/
data/
modules/douyin/webui/.tasks/
__pycache__/
*.pyc

logs/

# 模块 4 的配置文件里存着平台登录 Cookie（等同于账号凭证），绝不能入库
modules/live_recorder/config.json
modules/live_recorder/config.json.tmp

# 哔哩哔哩登录 Cookie（设置页「扫码获取」写入，等同账号凭证）
modules/bilibili/.cookies.json
modules/bilibili/.cookies.json.tmp

# clawfetch 测试输出目录：每次跑测试都会写入几十 MB~上百 MB 的 mock 负载，
# 属于纯运行产物（测试会按需自动重建），绝不能入库。
# 注：2026-08-29 那轮测试残留曾达 1 GB 并被误提交，已在 2026-09-23 清理并重写历史。
modules/clawfetch/tests/runs/

# ============ 上传 GitHub 前补充的安全过滤（2026-11-14 安全扫描） ============

# 本地浏览器 profile（含浏览器 Cookie、登录态、自动填充数据），等同账号凭证，绝不能入库
.data/

# 配置备份文件：config.json 备份里存有平台登录 Cookie（快手 passToken/web_st 等），绝不能入库
modules/live_recorder/config.json.bak-*
modules/douyin/config.yml.bak
modules/douyin/config.yml.testbak

# WebUI 运行态数据：account_cache 里存有抖音/快手账号缓存（可能含 Cookie）
modules/douyin/webui/.data/

# 下载器运行态状态文件
modules/douyin/core/.state/
modules/live_recorder/.daemon.lock

# 抓取的 Cookie JSON（grab_cookies.py 等工具的输出）
modules/stripchat/*cookies*.json
*cookies*.json.tmp

# Windows 快捷方式（含本机绝对路径，且非项目源码）
*.lnk
